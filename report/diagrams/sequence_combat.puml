@startuml
title Combat Sequence (Player turn)
actor Player
participant GameManager
participant CombatSystem
participant AttackStrategy
participant PlayerCharacter
participant Enemy

Player -> GameManager: start()
GameManager -> CombatSystem: startCombat(player, enemy)
CombatSystem -> PlayerCharacter: displayStats()
CombatSystem -> AttackStrategy: attack(player, enemy)
AttackStrategy -> PlayerCharacter: consumeBullet()
AttackStrategy -> Enemy: takeDamage(amount)
CombatSystem -> Enemy: if alive -> enemy.attack(player)
Enemy -> PlayerCharacter: takeDamage(amount)

@enduml
